root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{rs}]
indent_size = 4
max_line_length = 100

[*.{dart}]
indent_size = 2

[*.{yml,yaml,json,toml,proto}]
indent_size = 2

[*.md]
# Trailing whitespace is meaningful in Markdown line breaks.
trim_trailing_whitespace = false

[*.{ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab
